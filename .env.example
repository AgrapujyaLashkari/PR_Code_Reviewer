# Copy to .env and fill in. NEVER commit the real .env.

# --- database ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=code_review_agent

# --- auth ---
JWT_SECRET=change-me-in-your-local-env
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
FERNET_KEY=change-me-in-your-local-env

# --- llm (Gemini) ---
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.1
LLM_SEED=42
LLM_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=300

# --- GitHub App (create at https://github.com/settings/apps/new) ---
# Callback URL:  http://localhost:8001/api/v1/auth/github/callback
# Setup URL:     http://localhost:3000/repos/setup
# Webhook URL:   https://<public-host>/api/v1/github/webhook
# Permissions:   Contents (read), Pull requests (read & write), Metadata (read)
# Events:        pull_request, installation, installation_repositories
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8001/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:3000
GITHUB_API_URL=https://api.github.com

# --- analysis limits ---
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_REVIEW=200
MAX_FILE_BYTES=524288

# --- app ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
